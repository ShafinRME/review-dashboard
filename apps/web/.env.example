# Server-side only. The browser never calls this URL directly.
API_URL=http://localhost:4000/api

# Public URL of the deployed site, used for absolute metadata URLs.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional. When all four are set, the login page shows "Fill demo" buttons for reviewers.
NEXT_PUBLIC_DEMO_STUDENT_EMAIL=
NEXT_PUBLIC_DEMO_STUDENT_PASSWORD=
NEXT_PUBLIC_DEMO_MENTOR_EMAIL=
NEXT_PUBLIC_DEMO_MENTOR_PASSWORD=