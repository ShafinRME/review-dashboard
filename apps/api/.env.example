NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/review_dashboard?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=1d

SEED_MENTOR_NAME=Head Mentor
SEED_MENTOR_EMAIL=mentor@example.com
SEED_MENTOR_PASSWORD=change-me-before-seeding

SUBMISSION_RATE_LIMIT_MAX=5